# Desarrollo local. setup:env genera una contraseña si .env aún no existe.
NODE_ENV=development
# true conserva la verificación; false solo está permitido en development/test.
REQUIRE_EMAIL_VERIFICATION=true
PORT=3000
API_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5433
DB_EXTERNAL_PORT=5433
DB_NAME=unired
DB_USER=unired
DB_PASSWORD=CAMBIAR_CON_SETUP_ENV
# En Render: DATABASE_URL tiene prioridad sobre DB_*. No copies credenciales al repositorio.
# DATABASE_URL=postgresql://USUARIO:CONTRASENA@SERVIDOR:5432/BASE?sslmode=verify-full&channel_binding=require
# DB_SSL=true
STORAGE_ROOT=./storage
# local conserva el desarrollo actual; s3 usa objetos privados en Neon Storage o R2.
STORAGE_PROVIDER=local
# Completar únicamente en el backend cuando STORAGE_PROVIDER=s3.
# S3_BUCKET=private-media
# AWS_ENDPOINT_URL_S3=https://ENDPOINT_DEL_ALMACENAMIENTO
# AWS_REGION=REGION_DEL_ALMACENAMIENTO
# AWS_ACCESS_KEY_ID=CLAVE_DE_ACCESO
# AWS_SECRET_ACCESS_KEY=CLAVE_SECRETA
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=1073741824
UPLOAD_DOCUMENT_MAX_BYTES=20971520
UPLOAD_OWNER_MAX_BYTES=5368709120
JWT_ACCESS_SECRET=GENERAR_CON_SETUP_ENV
MAIL_ENCRYPTION_KEY=GENERAR_CON_SETUP_ENV
# file crea un buzón privado de desarrollo; producción requiere resend o smtp.
MAIL_TRANSPORT=file
MAIL_OUTBOX_ROOT=./.local-mails
# Render Free: usar MAIL_TRANSPORT=resend y completar estas variables en Render.
# RESEND_API_KEY=CLAVE_DEL_PROVEEDOR
# MAIL_FROM=UniRed <onboarding@resend.dev>
# El dominio de prueba solo envía al correo de tu cuenta Resend.
# CORS permite localhost en desarrollo. En producción: orígenes separados por coma.
CORS_ORIGINS=
# Origen del frontend, sin /#/home. Se utiliza en enlaces de correo.
# FRONTEND_URL=https://unired-link8500.netlify.app
# Límite de procesamiento simultáneo y usuarios con notificaciones en vivo.
MEDIA_MAX_JOBS=1
SSE_MAX_USERS=200
# Acceso social opcional. No copies estos secretos al frontend ni a GitHub.
# API_PUBLIC_URL=https://unired-backend-mpl6.onrender.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
# Windows utiliza Defender. En otro sistema configura clamav y AV_EXECUTABLE.
AV_PROVIDER=defender
# AV_EXECUTABLE=
# FFPROBE_PATH=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
