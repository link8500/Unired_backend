# Desarrollo local. setup:env genera una contraseña si .env aún no existe.
NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=5433
DB_EXTERNAL_PORT=5433
DB_NAME=unired
DB_USER=unired
DB_PASSWORD=CAMBIAR_CON_SETUP_ENV
STORAGE_ROOT=./storage
UPLOAD_IMAGE_MAX_BYTES=10485760
UPLOAD_VIDEO_MAX_BYTES=1073741824
UPLOAD_DOCUMENT_MAX_BYTES=20971520
UPLOAD_OWNER_MAX_BYTES=5368709120
JWT_ACCESS_SECRET=GENERAR_CON_SETUP_ENV
MAIL_ENCRYPTION_KEY=GENERAR_CON_SETUP_ENV
# file crea un buzón privado de desarrollo; producción requiere smtp.
MAIL_TRANSPORT=file
MAIL_OUTBOX_ROOT=./.local-mails
# CORS permite localhost en desarrollo. En producción: orígenes separados por coma.
CORS_ORIGINS=
# Windows utiliza Defender. En otro sistema configura clamav y AV_EXECUTABLE.
AV_PROVIDER=defender
# AV_EXECUTABLE=
# FFPROBE_PATH=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
